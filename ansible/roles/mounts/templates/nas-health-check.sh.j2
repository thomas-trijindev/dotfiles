#!/bin/bash
# NAS health check — restart autofs if any share is unreachable
failed=0
{% for share in nas_shares %}
if ! timeout 5 ls {{ nas_mount_base }}/{{ share }} &>/dev/null; then
    echo "NAS share {{ share }} unreachable" | systemd-cat -t nas-health-check -p warning
    failed=1
fi
{% endfor %}
if [ "$failed" -eq 1 ]; then
    systemctl restart autofs
fi
