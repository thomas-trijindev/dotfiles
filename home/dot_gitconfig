[user]
    name = Thomas Chai
    email = thomas.chai@trijin.dev
    signingkey = ~/.ssh/id_ed25519.pub

[gpg]
    format = ssh

[gpg "ssh"]
    program = ssh-keygen
    allowedSignersFile = ~/.ssh/allowed_signers

[commit]
    gpgsign = true

[core]
    editor = nvim

[pull]
    rebase = true

[init]
    defaultBranch = main
